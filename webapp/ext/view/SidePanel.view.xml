<mvc:View
    controllerName="customer.ravi.zproductshop.ext.controller.SidePanel"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Page id="sidePanelPage" showHeader="true" showNavButton="false">
        <customHeader>
            <Bar id="sidePanelHeaderBar">
			<contentLeft>
				<Image src=""></Image>
			</contentLeft>
                <contentRight>
                    <Button id="sidePanelCloseButton" icon="sap-icon://decline" type="Transparent" tooltip="Close" press="onClose"/>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
        	<VBox height="100%" class="sapUiResponsiveContentPadding mcpPage"  >
		<Bar>
			<contentLeft>
				<Title text="Toro AI Chat" level="H3"/>

				
			</contentLeft>
			<contentRight>
				<Button
					icon="sap-icon://decline"
					type="Transparent"
					tooltip="{i18n>closePanelTooltip}"
					press="onCloseSplitView"/>
					<Button icon="sap-icon://world" text="{/languageLabel}" tooltip="{i18n>btnLanguageTooltip}" press="onToggleLanguage" type="Transparent"/>
			<Button icon="sap-icon://action-settings" tooltip="{i18n>btnSettingsTooltip}" press="onOpenSettings" type="Transparent"/>
			</contentRight>
		</Bar>
		<VBox class="mcpChatWrapper">
				<Text id="statusText" class="mcpStatusBar" text="{/statusText}"/>
				<core:HTML id="chatHost" class="mcpChatHost" content="&lt;div&gt;&lt;/div&gt;" afterRendering="onChatHostRendered">
					<core:layoutData>
						<FlexItemData growFactor="1"/>
					</core:layoutData>
				</core:HTML>
			</VBox>
	</VBox>
     </content>
    </Page>
</mvc:View>
